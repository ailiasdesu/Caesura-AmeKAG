; =============================================================================
; Caesura KAG 教程 02 —— 文本与排版命令
;
; 目标：掌握文本相关的常用命令：字体、打字速度、说话人、语音、滚动字幕。
;
; 本教程覆盖命令：[font] [pt] [ch]（name/text/voice）[p] [wait] [scroll] [end]
;
; 提示：所有命令的参数都是可选的（除非标注必填），引擎会用默认值补齐。
; =============================================================================

[font face="default" size=22]
[pt speed=60]

; ---- 1. 改变字体与字号 -----------------------------------------------
; [font] 影响后续所有文本。size 单位是像素，范围 4..256。
[font face="default" size=26]
[ch name="Narrator" text="字号现在是 26。字体可以换成 assets/fonts 里的其他字体。"]
[p]

[font size=18]
[ch name="Narrator" text="字号又变成了 18。可以用 [font] 随时调整。"]
[p]

; ---- 2. 打字速度 -------------------------------------------------------
; [pt] 控制打字机效果速度（每字符毫秒，8..5000）。60 = 较快，300 = 慢速。
[pt speed=150]
[ch name="Narrator" text="这段文字以较慢的打字速度显示，适合强调。"]
[p]

[pt speed=60]
[ch name="Narrator" text="又回到快速模式了。"]
[p]

; ---- 3. 说话人 + 语音 --------------------------------------------------
; [ch] 的 voice 参数可以播放台词语音（assets/voice/ 下，支持 wav/ogg）。
; voice_wait 会在语音播完前阻塞推进（这里用 [voice_wait] 演示）。
[ch name="Sakura" text="嗨，我是樱。这是我的第一句带语音的台词！"
     voice="assets/voice/line01.wav"]
[voice_wait]
[p]

; ---- 4. 等待命令 --------------------------------------------------------
; [wait] 按毫秒阻塞执行（不等待玩家点击）。300ms 用于给玩家读屏幕的时间。
[wait time=300]

; ---- 5. 滚动字幕 --------------------------------------------------------
; [scroll] 显示一段滚动文字（用于片头/片尾字幕）。
[scroll text="Caesura 文本命令教程" speed=80]
[scroll text="Scroll 命令用于滚动字幕效果" speed=80]
[wait time=500]

; ---- 6. 收尾 -------------------------------------------------------------
[font size=22]
[ch name="Narrator" text="文本命令学完了！下一个教程：图层（tutorial_03）。"]
[p]
[end]
