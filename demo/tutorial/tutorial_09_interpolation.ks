; =============================================================================
; Caesura KAG 教程 09 —— 文本插值与表达式
;
; 目标：掌握文本内联插值三种语法与完整表达式语言。
;
; 三种插值（schema 的 interpolate 参数，作用于 [ch]/[text] 的 text）：
;   - $tbl.key     变量直接替换：$f.hp → 30
;   - %tbl.key%    KAG3 兼容形式：%f.name% → Aoi
;   - ${expr}      完整表达式（支持 TJS 运算符 && || ! != ?:）：
;                  ${f.hp > 20 ? 'high' : 'low'} → high
;
; 变量作用域：f（全局）/ sf（场景）/ tf（临时）/ mp（消息参数）/ lf（局部帧）
;
; 本教程覆盖命令：[set] [ch] [p] [end]
; =============================================================================

[font face="default" size=22]
[pt speed=60]

; ---- 1. 赋值（round 50 修复：引号正确剥离）-------------------------------
[set f.name = "Aoi"]
[set f.hp = 30]
[set f.flag = true]

; ---- 2. $tbl.key 直接替换 --------------------------------------------------
[ch name="Narrator" text="我的名字是 $f.name，HP 是 $f.hp。"]
[p]

; ---- 3. %tbl.key% KAG3 兼容形式 -------------------------------------------
[ch name="Narrator" text="KAG3 风格：%f.name% 向你问好。"]
[p]

; ---- 4. ${expr} 完整表达式（TJS 运算符可用）-------------------------------
[ch name="Narrator" text="状态：${f.hp > 20 ? '健康' : '危险'}（HP=$f.hp）"]
[p]
[ch name="Narrator" text="组合：${f.flag && f.hp > 10}（flag 与 HP 都满足）"]
[p]
[ch name="Narrator" text="计算：${f.hp * 10} 点经验值"]
[p]

; ---- 5. 缺失变量保留原样（便于调试）----------------------------------------
[ch name="Narrator" text="未定义变量显示：$f.missing（原样保留）"]
[p]

; ---- 6. 收尾 ---------------------------------------------------------------
[ch name="Narrator" text="插值教程完成！$f.name 的 HP 是 $f.hp。"]
[p]
[end]
